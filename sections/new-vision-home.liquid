    {"type":"textarea","id":"philosophy_heading","label":"Philosophy heading","default":"Ascend\nthe ordinary."},{"type":"textarea","id":"philosophy_text","label":"Philosophy text","default":"Creative Zoo exists for the ones who see the world differently. The creators, the misfits, the dreamers, the grinders — the ones who refuse to be caged."},{"type":"text","id":"philosophy_label","label":"Philosophy button","default":"Our story"},{"type":"url","id":"philosophy_link","label":"Philosophy link"},{"type":"textarea","id":"quote","label":"Quote","default":"Sometimes your greatest strength is the part the world told you to hide."},
    {"type":"text","id":"categories_heading","label":"Categories heading","default":"Shop by instinct"},{"type":"text","id":"categories_text","label":"Categories subtitle","default":"Different styles. Same mindset."},
