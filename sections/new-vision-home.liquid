{%- liquid
  assign featured_collection = section.settings.collection
  assign hero_image = section.settings.hero_image
  assign lab_image = section.settings.lab_image
-%}

<section class="cz-home section-{{ section.id }}" aria-label="Creative Zoo homepage">
  <div class="cz-hero">
    <div class="cz-hero__media">
      {%- if hero_image != blank -%}
        {{ hero_image | image_url: width: 2400 | image_tag: widths: '900, 1400, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="cz-wrap cz-hero__content">
      <p class="cz-micro">{{ section.settings.hero_eyebrow | escape }}</p>
      <h1>{{ section.settings.hero_heading | escape | newline_to_br }}</h1>
      <p class="cz-hero__copy">{{ section.settings.hero_text | escape }}</p>
      <div class="cz-actions">
        <a class="cz-btn cz-btn--cyan" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>
        <a class="cz-btn cz-btn--ghost" href="{{ section.settings.secondary_link | default: '#custom-lab' }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="cz-hero__note" aria-hidden="true">GOOD PEOPLE<br>WILD IDEAS</p>
  </div>

  <div class="cz-shop cz-wrap">
    <header class="cz-section-head">
      <div><h2>{{ section.settings.products_heading | escape }}</h2><p>{{ section.settings.products_text | escape }}</p></div>
      <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.products_link_label | escape }} <span aria-hidden="true">→</span></a>
    </header>
    <div class="cz-products">
      {%- if featured_collection != blank -%}
        {%- for product in featured_collection.products limit: 4 -%}
          <article class="cz-product">
            <a class="cz-product__image" href="{{ product.url }}">
              {%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 800 | image_tag: widths: '320, 500, 700, 800', sizes: '(min-width: 750px) 25vw, 80vw', loading: 'lazy', alt: product.featured_image.alt }}{%- endif -%}
              <span>{{ product.tags.first | default: 'New' | escape }}</span>
            </a>
            <div class="cz-product__meta"><div><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p>{{ product.type | default: 'Creative Zoo original' | escape }}</p><strong>{{ product.price | money }}</strong></div><a class="cz-cart" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">+</a></div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<article class="cz-product"><div class="cz-product__image">{{ 'product-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}<span>New</span></div><div class="cz-product__meta"><div><h3>Creative Zoo Original</h3><p>Fresh gear. Same instinct.</p><strong>$34.00</strong></div><span class="cz-cart">+</span></div></article>{%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="cz-philosophy">
    <div class="cz-philosophy__animal" aria-hidden="true">WILD<br>BY<br>NATURE.</div>
    <div class="cz-philosophy__copy"><p class="cz-micro">OUR PHILOSOPHY</p><h2>{{ section.settings.philosophy_heading | escape | newline_to_br }}</h2><p>{{ section.settings.philosophy_text | escape }}</p><a class="cz-btn cz-btn--black" href="{{ section.settings.philosophy_link }}">{{ section.settings.philosophy_label | escape }} <span aria-hidden="true">→</span></a></div>
    <blockquote>“{{ section.settings.quote | escape }}”<small>CREATIVITY CANNOT BE CAGED.</small></blockquote>
  </div>

  <div class="cz-instincts cz-wrap">
    <header class="cz-section-head"><div><h2>{{ section.settings.categories_heading | escape }}</h2><p>{{ section.settings.categories_text | escape }}</p></div></header>
    <div class="cz-instincts__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <a class="cz-instinct" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 750px) 25vw, 85vw', loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'collection-apparel-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            <span><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.caption | escape }}</small></span><b aria-hidden="true">→</b>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div id="custom-lab" class="cz-lab">
    <div class="cz-lab__media">{%- if lab_image != blank -%}{{ lab_image | image_url: width: 2400 | image_tag: widths: '900, 1400, 1800, 2400', sizes: '100vw', loading: 'lazy', alt: section.settings.lab_alt }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
    <div class="cz-wrap cz-lab__copy"><p class="cz-micro">THE CUSTOM LAB</p><h2>{{ section.settings.lab_heading | escape | newline_to_br }}</h2><p>{{ section.settings.lab_text | escape }}</p><div class="cz-actions"><a class="cz-btn cz-btn--cyan" href="{{ section.settings.lab_primary_link }}">{{ section.settings.lab_primary_label | escape }} →</a><a class="cz-btn cz-btn--ghost" href="{{ section.settings.lab_secondary_link }}">{{ section.settings.lab_secondary_label | escape }} →</a></div></div>
  </div>

  <div class="cz-social cz-wrap">
    <header class="cz-section-head"><div><h2>{{ section.settings.social_heading | escape }}</h2><p>{{ section.settings.social_text | escape }}</p></div><a href="{{ section.settings.social_link }}">{{ section.settings.social_label | escape }} →</a></header>
    <div class="cz-social__grid">{%- for block in section.blocks -%}{%- if block.type == 'social' -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: widths: '240, 400, 700', sizes: '(min-width: 750px) 16.66vw, 45vw', loading: 'lazy', alt: block.settings.alt }}{%- else -%}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</a>{%- endif -%}{%- endfor -%}</div>
  </div>
</section>

{% style %}
  .section-{{ section.id }} .cz-hero {
    min-height: {{ section.settings.hero_height }}px;
  }

  .section-{{ section.id }} .cz-hero__media img,
  .section-{{ section.id }} .cz-hero__media svg {
    object-position: {{ section.settings.hero_position_x }}% {{ section.settings.hero_position_y }}% !important;
  }

  .section-{{ section.id }} .cz-hero h1 {
    max-width: {{ section.settings.hero_text_width }}ch;
    font-size: clamp(5.4rem, calc({{ section.settings.hero_heading_size }} * 0.1vw), 11rem);
  }
{% endstyle %}

{% stylesheet %}
  .cz-home{--ink:#080909;--paper:#f2f0e9;--cyan:#00dce8;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}.cz-home *{box-sizing:border-box}.cz-wrap{width:min(100% - 8rem,144rem);margin-inline:auto}.cz-home h1,.cz-home h2,.cz-home h3{font-family:Impact,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:-.025em;margin:0;line-height:.88}.cz-micro{font-family:monospace;font-size:1.1rem;letter-spacing:.18em;text-transform:uppercase}.cz-hero{position:relative;min-height:59rem;display:flex;align-items:center;overflow:hidden;background:#050606;color:#fff}.cz-hero__media{position:absolute;inset:0}.cz-hero__media img,.cz-hero__media svg{width:100%;height:100%;object-fit:cover}.cz-hero__media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.32),transparent 65%)}.cz-hero__content{position:relative;z-index:1;padding-block:7rem 6rem}.cz-hero h1{white-space:nowrap;overflow-wrap:normal;word-break:normal;text-shadow:3px 3px 0 rgba(0,0,0,.22)}.cz-hero__copy{font-size:1.8rem;margin:1.5rem 0 0}.cz-actions{display:flex;flex-wrap:wrap;gap:1.4rem;margin-top:2.4rem}.cz-btn{display:inline-flex;align-items:center;gap:1.4rem;padding:1.5rem 2.5rem;border:1px solid;text-decoration:none;font-weight:800;font-size:1.2rem;letter-spacing:.06em;text-transform:uppercase}.cz-btn--cyan{background:var(--cyan);border-color:var(--cyan);color:#071013}.cz-btn--ghost{color:#fff;border-color:#fff}.cz-btn--black{background:#090a0a;color:#fff;border-color:#090a0a}.cz-btn:hover,.cz-btn:focus-visible{transform:translateY(-2px);outline:2px solid currentColor;outline-offset:3px}.cz-hero__note{position:absolute;z-index:1;right:4%;top:42%;font-family:cursive;font-size:2.3rem;line-height:1.05;transform:rotate(-9deg)}.cz-shop,.cz-instincts,.cz-social{padding-block:2.2rem}.cz-section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1rem}.cz-section-head h2{font-size:3.2rem}.cz-section-head p{margin:.3rem 0 0;font-size:1.2rem}.cz-section-head>a{color:inherit;font:700 1.1rem monospace;letter-spacing:.06em}.cz-products{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.cz-product__image{position:relative;display:block;aspect-ratio:1.45;background:#ddd;overflow:hidden}.cz-product__image img,.cz-product__image svg{width:100%;height:100%;object-fit:cover}.cz-product__image span{position:absolute;left:1rem;top:1rem;background:#080909;color:white;padding:.5rem 1rem;font:1rem monospace;text-transform:uppercase}.cz-product__meta{display:flex;justify-content:space-between;padding:.8rem .5rem}.cz-product h3{font:800 1.45rem Arial,sans-serif;letter-spacing:-.02em}.cz-product h3 a{color:inherit;text-decoration:none}.cz-product p,.cz-product strong{margin:.2rem 0;font-size:1.1rem}.cz-cart{width:3.4rem;height:3.4rem;display:grid;place-items:center;background:#090a0a;color:#fff;text-decoration:none;font-size:2rem}.cz-philosophy{display:grid;grid-template-columns:1.05fr 1.65fr .9fr;min-height:29rem;background:#d7d5cf}.cz-philosophy__animal{display:flex;align-items:center;justify-content:center;background:#0a0b0b;color:white;font:9rem/.7 Impact,sans-serif;text-align:center;overflow:hidden}.cz-philosophy__copy{padding:3rem}.cz-philosophy__copy h2{font-size:5rem}.cz-philosophy__copy>p:not(.cz-micro){max-width:48rem;font-size:1.3rem}.cz-philosophy blockquote{margin:0;padding:4rem 3rem;background:#e5e1d9;font:1.9rem/1.35 monospace;text-transform:uppercase}.cz-philosophy blockquote small{display:block;margin-top:3rem;font-size:1.2rem}.cz-instincts__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.cz-instinct{position:relative;aspect-ratio:1.55;display:block;overflow:hidden;background:#111;color:#fff}.cz-instinct:after{content:"";position:absolute;inset:25% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.84))}.cz-instinct>img,.cz-instinct>svg{width:100%;height:100%;object-fit:cover;transition:transform .4s}.cz-instinct:hover>img{transform:scale(1.04)}.cz-instinct>span{position:absolute;z-index:1;left:1.4rem;bottom:1.2rem}.cz-instinct strong{display:block;font:3rem/.9 Impact,sans-serif;text-transform:uppercase}.cz-instinct small{font-size:1.1rem}.cz-instinct>b{position:absolute;z-index:1;right:1.2rem;bottom:1.2rem;width:3.6rem;height:3.6rem;border:1px solid #fff;border-radius:50%;display:grid;place-items:center}.cz-lab{position:relative;min-height:36rem;background:#050606;color:#fff;display:flex;align-items:center;overflow:hidden}.cz-lab__media{position:absolute;inset:0}.cz-lab__media img{width:100%;height:100%;object-fit:cover}.cz-lab__copy{position:relative;z-index:1}.cz-lab__copy h2{font-size:clamp(5rem,6.5vw,9rem);max-width:7ch}.cz-lab__copy>p:not(.cz-micro){max-width:42rem;font-size:1.4rem}.cz-social__grid{display:grid;grid-template-columns:repeat(6,1fr)}.cz-social__grid a{aspect-ratio:1;overflow:hidden;background:#ddd}.cz-social__grid img,.cz-social__grid svg{width:100%;height:100%;object-fit:cover}.template-index .footer{background:#050606;color:#fff}.template-index .footer .footer__content-top{border-top:0}.cz-home .placeholder-svg{background:#d8d7d2;fill:#777}.template-index .header-wrapper{background:#050606;color:#fff;border-bottom:1px solid #303030}.template-index .header__menu-item,.template-index .header__icon{color:#fff}.template-index .header__heading-logo-wrapper{filter:grayscale(1) brightness(8)}
  @media(max-width:990px){.cz-wrap{width:min(100% - 4rem,144rem)}.cz-products,.cz-instincts__grid{grid-template-columns:repeat(2,1fr)}.cz-philosophy{grid-template-columns:1fr 1.6fr}.cz-philosophy blockquote{grid-column:1/-1}.cz-social__grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:749px){.cz-wrap{width:min(100% - 3rem,144rem)}.cz-hero{min-height:67rem;align-items:end}.cz-hero__media:after{background:linear-gradient(0deg,rgba(0,0,0,.94),transparent 80%)}.cz-hero__content{padding-block:12rem 5rem}.cz-hero h1{max-width:none!important;font-size:clamp(4.8rem,15vw,7rem)!important;white-space:nowrap}.cz-hero__note,.cz-hero__status{display:none}.cz-actions{flex-direction:column;align-items:stretch}.cz-btn{justify-content:center}.cz-section-head{align-items:start}.cz-products{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:1rem}.cz-product{min-width:78vw;scroll-snap-align:start}.cz-philosophy{grid-template-columns:1fr}.cz-philosophy__animal{min-height:20rem;font-size:7rem}.cz-philosophy__copy h2{font-size:4.4rem}.cz-instincts__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.cz-instinct{min-width:82vw;scroll-snap-align:start}.cz-lab{min-height:57rem;align-items:end}.cz-lab__media img{object-position:62% center}.cz-lab__copy{padding-block:5rem}.cz-lab__copy h2{font-size:5.2rem}.cz-social__grid{display:flex;overflow-x:auto}.cz-social__grid a{min-width:46vw}.cz-section-head>a{white-space:nowrap}}
{% endstylesheet %}

{% schema %}
{
