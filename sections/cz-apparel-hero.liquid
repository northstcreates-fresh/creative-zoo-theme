{% if collection.handle == 'apparel' %}
{{ 'section-cz-headwear-hero.css' | asset_url | stylesheet_tag }}

<section class="cz-headwear-hero cz-apparel-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="CzApparelTitle-{{ section.id }}">
  <div class="cz-headwear-hero__media" aria-hidden="true">
    <img
      src="{{ 'cz-apparel-hero-v1.jpg' | asset_url }}"
      alt=""
      width="1536"
      height="864"
      loading="eager"
      fetchpriority="high"
    >
  </div>
  <div class="cz-headwear-hero__shade"></div>
  <div class="cz-headwear-hero__content page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="cz-headwear-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 id="CzApparelTitle-{{ section.id }}" class="cz-headwear-hero__title">{{ collection.title | escape }}</h1>
    {% if section.settings.copy != blank %}
      <div class="cz-headwear-hero__copy rte">{{ section.settings.copy }}</div>
    {% elsif collection.description != blank %}
      <div class="cz-headwear-hero__copy rte">{{ collection.description }}</div>
    {% endif %}
    <a class="cz-headwear-hero__button button button--primary" href="#ApparelProductGrid">
      {{ section.settings.button_label | escape }}
      <span aria-hidden="true">→</span>
    </a>
  </div>
  {%- assign apparel_note_words = section.settings.note | split: ' ' -%}
  <p class="cz-headwear-hero__note" aria-hidden="true">
    {%- for word in apparel_note_words -%}
      {%- if forloop.last -%}<span>{{ word | escape }}</span>{%- else -%}{{ word | escape }} {% endif -%}
    {%- endfor -%}
  </p>
</section>
{% endif %}

{% schema %}
{
  "name": "Apparel hero",
  "tag": "section",
  "class": "cz-apparel-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WEAR YOUR INSTINCT" },
    { "type": "richtext", "id": "copy", "label": "Description", "default": "<p>Statement pieces for creators, misfits, and anyone built to stand apart.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP APPAREL" },
    { "type": "text", "id": "note", "label": "Side note", "default": "THRIVE OUTSIDE THE LINES." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Apparel hero" }]
}
{% endschema %}
