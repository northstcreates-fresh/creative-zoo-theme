{% if collection.handle == 'classics' %}
{{ 'section-cz-headwear-hero.css' | asset_url | stylesheet_tag }}

<section class="cz-headwear-hero cz-classics-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="CzClassicsTitle-{{ section.id }}">
  <div class="cz-headwear-hero__media" aria-hidden="true">
    <img
      src="{{ 'cz-classics-hero-bar-v1.jpg' | asset_url }}"
      alt=""
      width="1536"
      height="864"
      loading="eager"
      fetchpriority="high"
    >
  </div>
  <div class="cz-headwear-hero__shade"></div>
  <div class="cz-headwear-hero__content page-width">
    {% if section.settings.eyebrow != blank %}<p class="cz-headwear-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 id="CzClassicsTitle-{{ section.id }}" class="cz-headwear-hero__title">{{ collection.title | escape }}</h1>
    {% if section.settings.copy != blank %}
      <div class="cz-headwear-hero__copy rte">{{ section.settings.copy }}</div>
    {% elsif collection.description != blank %}
      <div class="cz-headwear-hero__copy rte">{{ collection.description }}</div>
    {% endif %}
    <a class="cz-headwear-hero__button button button--primary" href="#ClassicsProductGrid">
      {{ section.settings.button_label | escape }}
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <p class="cz-headwear-hero__note" aria-hidden="true">{{ section.settings.note | escape }}</p>
</section>
{% endif %}

{% schema %}
{
  "name": "Classics hero",
  "tag": "section",
  "class": "cz-classics-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE CREATIVE ZOO ORIGINALS" },
    { "type": "richtext", "id": "copy", "label": "Description", "default": "<p>Core marks. Timeless instincts. The pieces that started the story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP CLASSICS" },
    { "type": "text", "id": "note", "label": "Side note", "default": "THE ORIGINALS." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Classics hero" }]
}
{% endschema %}
